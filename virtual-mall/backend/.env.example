PORT=5000
FRONTEND_URL=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGDATABASE=virtual_mall
PGUSER=postgres
PGPASSWORD=replace_with_your_postgres_password
PGSSL=false

# Optional: image uploads. Leave blank to disable Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Stripe test mode. Keep secret key on the backend only.
STRIPE_SECRET_KEY=
